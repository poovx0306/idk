ALTER TABLE padres   ADD COLUMN apellido_materno TEXT;


-- 2. Quitar espacios dobles y sobrantes ------------------------------------

UPDATE infantes SET nombre =
    trim(replace(replace(replace(coalesce(nombre, ''), '  ', ' '), '  ', ' '), '  ', ' '));

UPDATE docente SET nombre =
    trim(replace(replace(replace(coalesce(nombre, ''), '  ', ' '), '  ', ' '), '  ', ' '));

UPDATE padres SET nombre =
    trim(replace(replace(replace(coalesce(nombre, ''), '  ', ' '), '  ', ' '), '  ', ' '));


-- 3. Repartir el nombre en las tres columnas -------------------------------
-- Convencion mexicana: nombre(s) + apellido paterno + apellido materno.
-- 1 palabra  -> solo nombre
-- 2 palabras -> nombre + paterno
-- 3 o mas    -> las ultimas dos son los apellidos, el resto es el nombre

UPDATE infantes SET
    apellido_materno = CASE
        WHEN length(nombre) - length(replace(nombre, ' ', '')) >= 2
        THEN substr(nombre, length(rtrim(nombre, replace(nombre, ' ', ''))) + 1)
        ELSE '' END,

    apellido_paterno = CASE
        WHEN length(nombre) - length(replace(nombre, ' ', '')) = 0 THEN ''
        WHEN length(nombre) - length(replace(nombre, ' ', '')) = 1
        THEN substr(nombre, length(rtrim(nombre, replace(nombre, ' ', ''))) + 1)
        ELSE substr(
                rtrim(substr(nombre, 1, length(rtrim(nombre, replace(nombre, ' ', ''))))),
                length(rtrim(
                    rtrim(substr(nombre, 1, length(rtrim(nombre, replace(nombre, ' ', ''))))),
                    replace(rtrim(substr(nombre, 1, length(rtrim(nombre, replace(nombre, ' ', ''))))), ' ', '')
                )) + 1)
        END,

    nombre = CASE
        WHEN length(nombre) - length(replace(nombre, ' ', '')) = 0 THEN nombre
        WHEN length(nombre) - length(replace(nombre, ' ', '')) = 1
        THEN rtrim(substr(nombre, 1, length(rtrim(nombre, replace(nombre, ' ', '')))))
        ELSE rtrim(substr(
                rtrim(substr(nombre, 1, length(rtrim(nombre, replace(nombre, ' ', ''))))),
                1,
                length(rtrim(
                    rtrim(substr(nombre, 1, length(rtrim(nombre, replace(nombre, ' ', ''))))),
                    replace(rtrim(substr(nombre, 1, length(rtrim(nombre, replace(nombre, ' ', ''))))), ' ', '')
                ))))
        END;


